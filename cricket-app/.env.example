# Copy this file to .env and fill in your own Firebase project's values
# (Firebase console → Project settings → Your apps → SDK setup and configuration).
# .env is gitignored — these values never get committed to source control.
#
# If you leave this unset, the app falls back to whatever project it
# shipped configured for. For a real deployment, use your own project so
# you control the Firestore Security Rules and who can read/write data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
